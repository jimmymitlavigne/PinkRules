#!name=NewsBilingual 新闻双语（原生 / WebView）
#!desc=NYT、FT、WSJ WebView 按需双语；经济学人原生正文后台译文需另加同一 JS 定时任务，保留网页兼容。默认隐藏页面广告位；WSJ 保留 App 原阅读方式，撤销 0.8.3 网页跳转。
#!version=0.8.5
hostname = wsj.com, www.wsj.com, webview.wsj.com, nytimes.com, www.nytimes.com, samizdat-graphql.nytimes.com, ft.com, www.ft.com, app.ft.com, app-api.ft.com, economist.com, www.economist.com, api.economist.com, shared-data.dowjones.io, news-bilingual.invalid, securepubads.g.doubleclick.net, pubads.g.doubleclick.net, mdtb-cf-2.ads.aps.amazon-adsystem.com, *.safeframe.googlesyndication.com

^https:\/\/(?:(?:www\.|webview\.)?wsj\.com|(?:www\.)?(?:nytimes\.com|economist\.com)|(?:www\.|app\.)?ft\.com)(?::443)?\/__news_bilingual__\/v2\/translate(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
^https:\/\/(?:(?:www\.|webview\.)?wsj\.com|(?:www\.)?(?:nytimes\.com|economist\.com)|(?:www\.|app\.)?ft\.com)(?::443)?\/__news_bilingual__\/v2\/(?:client\.js|status|diagnostic|runtime)(?:\?.*)?$ url script-echo-response https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
^https:\/\/samizdat-graphql\.nytimes\.com(?::443)?\/graphql\/v2\?(?:[^#]*&)?operationName=Asset(?:&[^#]*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
^https:\/\/(?:(?:www\.|webview\.)?wsj\.com|(?:www\.)?(?:nytimes\.com|economist\.com)|(?:www\.|app\.)?ft\.com)(?::443)?\/(?!__news_bilingual__\/)(?!_{1,2}origami\/service\/image\/)(?!_next\/|vi-assets\/|assets?\/|static\/|images?\/|fonts?\/|videos?\/)(?![^?#]*\.(?:avif|bmp|css|gif|ico|jpe?g|js|m4a|m4v|mov|mp3|mp4|m3u8|pdf|png|svg|ttf|webm|webp|woff2?)(?:[?#]|$)) url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
# WSJ App page script observed in the capture; other Next.js assets stay untouched.
^https:\/\/webview\.wsj\.com(?::443)?\/_next\/static\/chunks\/pages\/webview\/(?:\[id\]|%5[Bb]id%5[Dd])-[A-Za-z0-9_-]+\.js(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
^https:\/\/app-api\.ft\.com(?::443)?\/startupcheck(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
# FT/WSJ structured bodies are diagnostic-only; WSJ lists only undo recognized v0.8.3 redirects. Economist native text collection requires a separate QX task.
^https:\/\/app-api\.ft\.com(?::443)?\/__content\/v6\/article\/[0-9a-f-]+(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
^https:\/\/shared-data\.dowjones\.io(?::443)?\/gateway\/graphql\?(?:[^#]*&)?operationName=(?:ArticleContent|SummaryCollectionContentV2|BundledRecommendedArticles)(?:&[^#]*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
^https:\/\/api\.economist\.com(?::443)?\/teg\/content\/b2c-mobile\/cp2-gateway\/graphql\?(?:[^#]*&)?operationName=(?:Articles?Query|FindHomepage|FindTagArticles)(?:&[^#]*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
# Obtain full article responses; media, account and unrelated API requests are excluded.
^https:\/\/api\.economist\.com(?::443)?\/teg\/content\/b2c-mobile\/cp2-gateway\/graphql\?(?:[^#]*&)?operationName=Articles?Query(?:&[^#]*)?$ url script-request-header https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
^https:\/\/webview\.wsj\.com(?::443)?\/(?:webview\/[^/?#]+|_next\/static\/chunks\/pages\/webview\/(?:\[id\]|%5[Bb]id%5[Dd])-[A-Za-z0-9_-]+\.js)(?:\?.*)?$ url script-request-header https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
# Local management origin: no public website receives settings submissions.
^https:\/\/news-bilingual\.invalid(?::443)?\/__news_bilingual__\/v2\/(?:settings|cache|native-articles)(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
^https:\/\/news-bilingual\.invalid(?::443)?\/__news_bilingual__\/v2\/translate(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
^https:\/\/news-bilingual\.invalid(?::443)?\/__news_bilingual__\/v2\/(?:diagnostic|status)(?:\?.*)?$ url script-echo-response https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
# Observed ad delivery only. SDK scripts, login and article endpoints are excluded.
^https:\/\/(?:securepubads|pubads)\.g\.doubleclick\.net(?::443)?\/gampad\/ads(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
^https:\/\/mdtb-cf-2\.ads\.aps\.amazon-adsystem\.com(?::443)?\/e\/msdk\/ads(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
^https:\/\/[a-z0-9]+\.safeframe\.googlesyndication\.com(?::443)?\/safeframe\/[0-9-]+\/html\/container\.html(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.8.5
