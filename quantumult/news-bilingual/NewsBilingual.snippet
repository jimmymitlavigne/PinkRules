#!name=NewsBilingual 新闻双语（HTML / WebView）
#!desc=按需双语，默认隐藏页面正文广告位；NYT、FT、WSJ WebView。经济学人保留原生阅读器，强制网页入口需手动开启；WSJ 原生正文仅诊断。
#!version=0.7.4
hostname = wsj.com, www.wsj.com, webview.wsj.com, nytimes.com, www.nytimes.com, samizdat-graphql.nytimes.com, ft.com, www.ft.com, app.ft.com, app-api.ft.com, economist.com, www.economist.com, api.economist.com, shared-data.dowjones.io, news-bilingual.invalid, securepubads.g.doubleclick.net, pubads.g.doubleclick.net, mdtb-cf-2.ads.aps.amazon-adsystem.com, *.safeframe.googlesyndication.com

^https:\/\/(?:(?:www\.|webview\.)?wsj\.com|(?:www\.)?(?:nytimes\.com|economist\.com)|(?:www\.|app\.)?ft\.com)(?::443)?\/__news_bilingual__\/v2\/translate(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.7.4
^https:\/\/(?:(?:www\.|webview\.)?wsj\.com|(?:www\.)?(?:nytimes\.com|economist\.com)|(?:www\.|app\.)?ft\.com)(?::443)?\/__news_bilingual__\/v2\/(?:client\.js|status|diagnostic|runtime)(?:\?.*)?$ url script-echo-response https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.7.4
^https:\/\/samizdat-graphql\.nytimes\.com(?::443)?\/graphql\/v2\?(?:[^#]*&)?operationName=Asset(?:&[^#]*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.7.4
^https:\/\/(?:(?:www\.|webview\.)?wsj\.com|(?:www\.)?(?:nytimes\.com|economist\.com)|(?:www\.|app\.)?ft\.com)(?::443)?\/(?!__news_bilingual__\/)(?!_{1,2}origami\/service\/image\/)(?!_next\/|vi-assets\/|assets?\/|static\/|images?\/|fonts?\/|videos?\/)(?![^?#]*\.(?:avif|bmp|css|gif|ico|jpe?g|js|m4a|m4v|mov|mp3|mp4|m3u8|pdf|png|svg|ttf|webm|webp|woff2?)(?:[?#]|$)) url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.7.4
^https:\/\/app-api\.ft\.com(?::443)?\/startupcheck(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.7.4
# FT/WSJ structured bodies are diagnostic-only. Economist WebView preference is experimental.
^https:\/\/app-api\.ft\.com(?::443)?\/__content\/v6\/article\/[0-9a-f-]+(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.7.4
^https:\/\/shared-data\.dowjones\.io(?::443)?\/gateway\/graphql\?(?:[^#]*&)?operationName=ArticleContent(?:&[^#]*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.7.4
^https:\/\/api\.economist\.com(?::443)?\/teg\/content\/b2c-mobile\/cp2-gateway\/graphql\?(?:[^#]*&)?operationName=(?:Articles?Query|FindHomepage|FindTagArticles)(?:&[^#]*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.7.4
# Local management origin: no public website receives settings submissions.
^https:\/\/news-bilingual\.invalid(?::443)?\/__news_bilingual__\/v2\/(?:settings|cache)(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.7.4
^https:\/\/news-bilingual\.invalid(?::443)?\/__news_bilingual__\/v2\/translate(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.7.4
^https:\/\/news-bilingual\.invalid(?::443)?\/__news_bilingual__\/v2\/(?:diagnostic|status)(?:\?.*)?$ url script-echo-response https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.7.4
# Observed ad delivery only. SDK scripts, login and article endpoints are excluded.
^https:\/\/(?:securepubads|pubads)\.g\.doubleclick\.net(?::443)?\/gampad\/ads(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.7.4
^https:\/\/mdtb-cf-2\.ads\.aps\.amazon-adsystem\.com(?::443)?\/e\/msdk\/ads(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.7.4
^https:\/\/[a-z0-9]+\.safeframe\.googlesyndication\.com(?::443)?\/safeframe\/[0-9-]+\/html\/container\.html(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/jimmymitlavigne/PinkRules/master/quantumult/news-bilingual/NewsBilingual.js?v=0.7.4
